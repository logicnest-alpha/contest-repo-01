# Copy to .env (or set these in your host's dashboard) and fill in.

# PostgreSQL 14+. A free Supabase project works: Connect > "Session pooler" connection string (port 5432),
# not the Transaction pooler (port 6543).
DATABASE_URL=postgres://user:password@localhost:5432/outreach

# Random string, at least 32 characters. Encrypts mailbox passwords + API keys and signs logins.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if it changes, stored mailbox passwords can no longer be decrypted.
APP_SECRET=

# Your login for the web app.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Optional: public https URL of this app. Enables one-click unsubscribe links (RFC 8058).
# Without it, the List-Unsubscribe header uses mailto: only (which also works).
PUBLIC_URL=

PORT=3000

# Optional: integrations can also be added later on the Settings page (stored encrypted).
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Set to "off" on a second copy of the app that should only serve the UI.
ENGINES=on
